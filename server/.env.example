# Copy to .env on the server PC and fill in values.

# Postgres on THIS machine (keep host as 127.0.0.1 — do not expose Postgres to Wi‑Fi)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/modi_electricals

# API listens on all interfaces so TSplus / office PCs on Wi‑Fi can connect
PORT=8787
HOST=0.0.0.0

# Long random secret — same value goes in the app as "API token"
# Generate one: openssl rand -hex 32
MODI_API_TOKEN=change-me-to-a-long-random-secret

# Optional: allow browser origins (comma-separated). Empty = allow all LAN origins.
# CORS_ORIGINS=http://192.168.1.10:5173
